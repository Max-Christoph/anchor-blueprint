# ---------------------------------------------------------------------------
# Enterprise Tool - Umgebungsvariablen
# Kopieren: cp .env.example .env
# Jede Variable hat in docker-compose.yml einen Fallback. Echte Secrets
# gehoeren NICHT in diese Datei, sondern in einen Secret-Store (z. B. Vault,
# Docker Secrets, Cloud Secret Manager).
# ---------------------------------------------------------------------------

# --- Allgemein -------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# --- Host-Binding und Ports ------------------------------------------------
# 127.0.0.1 = nur lokal erreichbar. Fuer LAN-Zugriff auf 0.0.0.0 setzen.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8080
WORKER_PORT=8000
DB_PORT=5432

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=enterprise
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=change-me-in-development
DB_MAX_CONNS=10

# Nur fuer lokale Entwicklung ausserhalb von Docker (go run ./cmd/server):
# DATABASE_URL=postgres://enterprise:change-me-in-development@127.0.0.1:5432/enterprise?sslmode=disable

# --- Backend (Go) ----------------------------------------------------------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
WORKER_TIMEOUT=10s

# Auth-Stub: Bearer-Token ODER X-User-Email-Header.
# WICHTIG: Stub fuer lokale Entwicklung, in Produktion durch OIDC/JWT ersetzen.
AUTH_BEARER_TOKEN=dev-bearer-token-change-me
AUTH_ALLOWED_EMAIL_DOMAINS=example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Build-Time, Vite) -------------------------------------------
# Leer = relative Pfade, Nginx proxied /api an das Backend (empfohlen).
VITE_API_BASE_URL=
# Demo-Identitaet fuer den Auth-Stub im Browser.
VITE_DEMO_USER_EMAIL=demo.user@example.com

# --- Worker (Python) -------------------------------------------------------
WORKER_MAX_VALUES=10000
