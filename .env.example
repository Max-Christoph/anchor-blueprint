# ---------------------------------------------------------------------------
# Anchor Blueprint - Umgebungsvariablen
# Kopieren: cp .env.example .env
# Jede Variable hat in docker-compose.yml einen Fallback. Echte Secrets
# gehoeren NICHT in diese Datei, sondern in einen Secret-Store (z.B. Vault,
# Docker Secrets, Cloud Secret Manager).
# ---------------------------------------------------------------------------

# --- Allgemein -------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.4.0
LOG_LEVEL=info

# --- Host-Binding und Ports ------------------------------------------------
# 127.0.0.1 = nur lokal erreichbar. Fuer LAN-Zugriff auf 0.0.0.0 setzen.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8080
WORKER_PORT=8000
DB_PORT=5432

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=anchor
POSTGRES_USER=anchor
POSTGRES_PASSWORD=change-me-in-development
DB_MAX_CONNS=10
# Migrationen (golang-migrate, ausschliesslich DDL) beim Start anwenden
DB_AUTO_MIGRATE=true
# Beispieldaten separat einspielen (Start oder `make seed`) - nie in Produktion
DB_SEED_DEV_DATA=true

# Nur fuer lokale Entwicklung ausserhalb von Docker (go run ./cmd/server):
# DATABASE_URL=postgres://anchor:change-me-in-development@127.0.0.1:5432/anchor?sslmode=disable

# --- Authentifizierung -----------------------------------------------------
# jwt        = RS256-JWT-Validierung gegen OIDC-JWKS (Produktion, Standard im Code)
# dev_header = X-User-Email mit Domain-Allowlist (nur lokal, nicht faelschungssicher)
# mock       = wie dev_header (Alias fuer lokale Tests)
AUTH_MODE=dev_header

# OIDC (Pflicht bei AUTH_MODE=jwt), Beispiel Microsoft Entra ID:
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=api://anchor-blueprint
# OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_TTL=15m
OIDC_HTTP_TIMEOUT=5s
AUTH_CLOCK_LEEWAY=30s

# --- RBAC ------------------------------------------------------------------
# Namen der Claims, aus denen Rollen/Gruppen gelesen werden
AUTH_ROLES_CLAIM=roles
AUTH_GROUPS_CLAIM=groups
# Gruppen-IDs (z. B. Entra-Objekt-IDs) auf zusaetzliche Rollen mappen:
# Format "group-id=Admin;andere-id=Operator,Viewer"
OIDC_GROUP_ROLE_MAP=
# Rolle, die im Dev-Modus gilt, wenn X-User-Roles fehlt
AUTH_DEV_DEFAULT_ROLE=User

# Dev-Modus: statischer Service-Token und erlaubte Header-Domains
AUTH_BEARER_TOKEN=dev-bearer-token-change-me
AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# --- Backend (Go) ----------------------------------------------------------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
WORKER_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Build-Time, Vite) -------------------------------------------
# Leer = relative Pfade, Nginx proxied /api an das Backend (empfohlen).
VITE_API_BASE_URL=
# Dev-Modus-Identitaet im Browser (wird im JWT-Modus ignoriert).
VITE_DEMO_USER_EMAIL=demo.user@example.com
# Optional: Bearer-Token fuer den Dev-Modus (dann gewinnt der Token).
VITE_BEARER_TOKEN=

# --- Worker (Python) -------------------------------------------------------
WORKER_MAX_VALUES=10000
